DATABASE_URL="postgresql://claimapp:claimapp@localhost:5432/claimapp"
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
PORT=4000

# --- First admin account ---
# Run `npm run bootstrap-admin` (or, in production, it runs automatically on container start)
# to create this account as ADMIN if it doesn't exist yet. Leave unset to skip.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-to-a-strong-password
# ADMIN_NAME=Admin

# --- File storage ---
# STORAGE_DRIVER=local (default) stores uploads on local disk under server/uploads/.
# STORAGE_DRIVER=s3 stores uploads in any S3-compatible bucket (AWS S3, DigitalOcean Spaces,
# Cloudflare R2, Backblaze B2, Wasabi, MinIO, GCS via interop mode). See CLOUD_DEPLOYMENT.md.
STORAGE_DRIVER=local

# Only needed when STORAGE_DRIVER=s3:
# S3_BUCKET=my-claim-app-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=                      # leave unset for AWS S3; set for other providers (see CLOUD_DEPLOYMENT.md)
# S3_FORCE_PATH_STYLE=false         # set to true for MinIO / most non-AWS S3-compatible providers
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=               # set if the bucket/CDN is public; otherwise presigned URLs are generated
# S3_PRESIGN_EXPIRY_SECONDS=3600    # only used when S3_PUBLIC_BASE_URL is not set
