# Used by docker-compose.prod.yml. Copy to .env and fill in real values before deploying.
# Do not commit the real .env file.

# --- Postgres ---
POSTGRES_USER=claimapp
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=claimapp

# --- App secrets (generate with: openssl rand -base64 48) ---
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# --- First admin account ---
# On every container start, the server creates this account as ADMIN if it doesn't exist yet
# (or promotes it to ADMIN if it already exists as a lower role). Leave both unset to skip —
# you'd then need to register + promote via SQL manually (see DEPLOYMENT.md).
# This does NOT reset the password of an already-existing account, so it's safe to leave these
# values in .env indefinitely (e.g. after you've since changed the password via the app).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Admin

# --- File storage ---
# local (default) = disk inside the server container, persisted via the claimapp_uploads volume.
# s3 = any S3-compatible bucket. See CLOUD_DEPLOYMENT.md for provider-specific values.
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
# S3_PRESIGN_EXPIRY_SECONDS=3600
